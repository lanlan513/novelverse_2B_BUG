{
  "name": "novelverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite --host 0.0.0.0\"",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:anchor && npm run test:dom && npm run test:perf && npm run test:app",
    "test:anchor": "node scripts/test-anchor.mjs",
    "test:dom": "node scripts/test-dom.mjs",
    "test:perf": "node scripts/test-perf.mjs",
    "test:app": "npm run build && node scripts/test-app.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
